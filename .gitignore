# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# Generated data files (fetched via prebuild script)
/public/reports.json
/public/reports_list.json
/public/reports_metadata.json
/public/data/

# Protected server-side data
/data/
ssi_price_api/config.py
ssi_price_api/

# Temporary and test scripts
test_*.js
test_*.py
test_*.cjs
verify_order.js
fetch_forecast*.cjs
find_txt_r2.cjs
read_txt_r2.cjs

# Logs and environment dumps
*.log
vercel_envs.txt

# Data artifacts
*.json
!package.json
!package-lock.json
!jsconfig.json
!eslint.config.mjs
!public/*.svg
!public/favicon.ico
vnstock_data/data/
scripts/peek_temp.json
